{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/E8A281E6ACA2/perfassess/docs/report.schema.json",
  "title": "Performance Assessment Report",
  "type": "object",
  "required": [
    "session_id",
    "timestamp",
    "system_info",
    "test_results",
    "summary"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "system_info": {
      "type": "object",
      "required": [
        "cpu",
        "memory",
        "disk",
        "os"
      ],
      "properties": {
        "cpu": {
          "type": "object",
          "required": [
            "model",
            "cores",
            "threads",
            "frequency_mhz"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "cores": {
              "type": "number"
            },
            "threads": {
              "type": "number"
            },
            "frequency_mhz": {
              "type": "number"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "total_mb",
            "available_mb"
          ],
          "properties": {
            "total_mb": {
              "type": "number"
            },
            "available_mb": {
              "type": "number"
            },
            "memory_type": {
              "type": "string"
            }
          }
        },
        "disk": {
          "type": "object",
          "required": [
            "total_gb",
            "available_gb"
          ],
          "properties": {
            "total_gb": {
              "type": "number"
            },
            "available_gb": {
              "type": "number"
            },
            "disk_type": {
              "type": "string"
            }
          }
        },
        "os": {
          "type": "object",
          "required": [
            "name",
            "version",
            "architecture"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            }
          }
        }
      }
    },
    "test_results": {
      "type": "object",
      "properties": {
        "cpu_result": {
          "type": "object",
          "required": [
            "test_name",
            "status",
            "duration_seconds",
            "metrics"
          ],
          "properties": {
            "test_name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failed",
                "skipped",
                "degraded"
              ]
            },
            "duration_seconds": {
              "type": "number"
            },
            "metrics": {
              "type": "object",
              "required": [
                "backend",
                "single_core_score",
                "multi_core_score",
                "total_score",
                "cpu_cores"
              ],
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "builtin",
                    "sysbench",
                    "geekbench"
                  ]
                },
                "single_core_source": {
                  "type": "string"
                },
                "single_core_score": {
                  "type": "number"
                },
                "single_core_raw_score": {
                  "type": "number"
                },
                "single_core_events_per_sec": {
                  "type": "number"
                },
                "multi_core_source": {
                  "type": "string"
                },
                "multi_core_score": {
                  "type": "number"
                },
                "multi_core_raw_score": {
                  "type": "number"
                },
                "multi_core_events_per_sec": {
                  "type": "number"
                },
                "total_score": {
                  "type": "number"
                },
                "cpu_cores": {
                  "type": "number"
                }
              }
            }
          }
        },
        "memory_result": {
          "type": "object",
          "required": [
            "test_name",
            "status",
            "duration_seconds",
            "metrics"
          ],
          "properties": {
            "test_name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failed",
                "skipped",
                "degraded"
              ]
            },
            "duration_seconds": {
              "type": "number"
            },
            "metrics": {
              "type": "object",
              "required": [
                "backend",
                "read_speed_mbps",
                "write_speed_mbps",
                "score"
              ],
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "builtin",
                    "sysbench"
                  ]
                },
                "read_speed_mbps": {
                  "type": "number"
                },
                "read_speed_source": {
                  "type": "string"
                },
                "write_speed_mbps": {
                  "type": "number"
                },
                "write_speed_source": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "test_size_mb": {
                  "type": "number"
                }
              }
            }
          }
        },
        "disk_result": {
          "type": "object",
          "required": [
            "test_name",
            "status",
            "duration_seconds",
            "metrics"
          ],
          "properties": {
            "test_name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failed",
                "skipped",
                "degraded"
              ]
            },
            "duration_seconds": {
              "type": "number"
            },
            "metrics": {
              "type": "object",
              "required": [
                "backend",
                "random_iops",
                "score"
              ],
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "builtin",
                    "fio"
                  ]
                },
                "sequential_read_mbps": {
                  "type": "number"
                },
                "read_speed_mbps": {
                  "type": "number"
                },
                "sequential_read_source": {
                  "type": "string"
                },
                "sequential_write_mbps": {
                  "type": "number"
                },
                "write_speed_mbps": {
                  "type": "number"
                },
                "sequential_write_source": {
                  "type": "string"
                },
                "random_iops": {
                  "type": "number"
                },
                "random_iops_source": {
                  "type": "string"
                },
                "random_read_mbps": {
                  "type": "number"
                },
                "random_write_mbps": {
                  "type": "number"
                },
                "random_read_iops": {
                  "type": "number"
                },
                "random_write_iops": {
                  "type": "number"
                },
                "random_read_latency_p95_ms": {
                  "type": "number"
                },
                "random_write_latency_p95_ms": {
                  "type": "number"
                },
                "fio_mixed_profile": {
                  "type": "string",
                  "enum": [
                    "yabs_randrw_50_50"
                  ]
                },
                "fio_mixed_block_sizes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fio_mixed_4k_read_mbps": {
                  "type": "number"
                },
                "fio_mixed_4k_write_mbps": {
                  "type": "number"
                },
                "fio_mixed_4k_total_mbps": {
                  "type": "number"
                },
                "fio_mixed_4k_read_iops": {
                  "type": "number"
                },
                "fio_mixed_4k_write_iops": {
                  "type": "number"
                },
                "fio_mixed_4k_total_iops": {
                  "type": "number"
                },
                "fio_mixed_64k_read_mbps": {
                  "type": "number"
                },
                "fio_mixed_64k_write_mbps": {
                  "type": "number"
                },
                "fio_mixed_64k_total_mbps": {
                  "type": "number"
                },
                "fio_mixed_64k_read_iops": {
                  "type": "number"
                },
                "fio_mixed_64k_write_iops": {
                  "type": "number"
                },
                "fio_mixed_64k_total_iops": {
                  "type": "number"
                },
                "fio_mixed_512k_read_mbps": {
                  "type": "number"
                },
                "fio_mixed_512k_write_mbps": {
                  "type": "number"
                },
                "fio_mixed_512k_total_mbps": {
                  "type": "number"
                },
                "fio_mixed_512k_read_iops": {
                  "type": "number"
                },
                "fio_mixed_512k_write_iops": {
                  "type": "number"
                },
                "fio_mixed_512k_total_iops": {
                  "type": "number"
                },
                "fio_mixed_1m_read_mbps": {
                  "type": "number"
                },
                "fio_mixed_1m_write_mbps": {
                  "type": "number"
                },
                "fio_mixed_1m_total_mbps": {
                  "type": "number"
                },
                "fio_mixed_1m_read_iops": {
                  "type": "number"
                },
                "fio_mixed_1m_write_iops": {
                  "type": "number"
                },
                "fio_mixed_1m_total_iops": {
                  "type": "number"
                },
                "score": {
                  "type": "number"
                }
              }
            }
          }
        },
        "network_result": {
          "type": "object",
          "required": [
            "test_name",
            "status",
            "duration_seconds",
            "metrics"
          ],
          "properties": {
            "test_name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failed",
                "skipped",
                "degraded"
              ]
            },
            "duration_seconds": {
              "type": "number"
            },
            "metrics": {
              "type": "object",
              "required": [
                "backend",
                "average_latency_ms",
                "download_speed_mbps",
                "upload_speed_mbps",
                "upload_speed_estimated",
                "score"
              ],
              "properties": {
                "backend": {
                  "type": "string",
                  "enum": [
                    "builtin",
                    "iperf3",
                    "speedtest"
                  ]
                },
                "backend_server": {
                  "type": "string"
                },
                "average_latency_ms": {
                  "type": "number"
                },
                "latency_source": {
                  "type": "string"
                },
                "download_speed_mbps": {
                  "type": "number"
                },
                "download_speed_source": {
                  "type": "string"
                },
                "upload_speed_mbps": {
                  "type": "number"
                },
                "upload_speed_source": {
                  "type": "string"
                },
                "upload_speed_estimated": {
                  "type": "boolean"
                },
                "network_error": {
                  "type": "string"
                },
                "speedtest_profile": {
                  "type": "string",
                  "enum": [
                    "ookla_cli"
                  ]
                },
                "speedtest_server_id": {
                  "type": "number"
                },
                "speedtest_server_name": {
                  "type": "string"
                },
                "speedtest_server_location": {
                  "type": "string"
                },
                "speedtest_server_country": {
                  "type": "string"
                },
                "speedtest_server_host": {
                  "type": "string"
                },
                "speedtest_result_id": {
                  "type": "string"
                },
                "speedtest_result_url": {
                  "type": "string"
                },
                "speedtest_isp": {
                  "type": "string"
                },
                "speedtest_interface_name": {
                  "type": "string"
                },
                "speedtest_interface_internal_ip": {
                  "type": "string"
                },
                "speedtest_interface_external_ip": {
                  "type": "string"
                },
                "speedtest_interface_mac": {
                  "type": "string"
                },
                "speedtest_interface_is_vpn": {
                  "type": "boolean"
                },
                "speedtest_ping_jitter_ms": {
                  "type": "number"
                },
                "network_quality_profile": {
                  "type": "string",
                  "enum": [
                    "tcp_connect_matrix"
                  ]
                },
                "network_quality_target_count": {
                  "type": "number"
                },
                "network_quality_ipv4_available": {
                  "type": "boolean"
                },
                "network_quality_ipv6_available": {
                  "type": "boolean"
                },
                "network_quality_ipv4_failure_rate": {
                  "type": "number"
                },
                "network_quality_ipv6_failure_rate": {
                  "type": "number"
                },
                "network_quality_failure_rate": {
                  "type": "number"
                },
                "network_quality_avg_latency_ms": {
                  "type": "number"
                },
                "network_quality_jitter_ms": {
                  "type": "number"
                },
                "iperf3_matrix_profile": {
                  "type": "string",
                  "enum": [
                    "multi_server"
                  ]
                },
                "iperf3_matrix_server_count": {
                  "type": "number"
                },
                "iperf3_matrix_success_count": {
                  "type": "number"
                },
                "iperf3_matrix_avg_download_mbps": {
                  "type": "number"
                },
                "iperf3_matrix_avg_upload_mbps": {
                  "type": "number"
                },
                "iperf3_matrix_best_download_mbps": {
                  "type": "number"
                },
                "iperf3_matrix_best_upload_mbps": {
                  "type": "number"
                },
                "score": {
                  "type": "number"
                }
              },
              "patternProperties": {
                "^iperf3_matrix_[0-9]+_(server|host|protocol|port|error)$": {
                  "type": "string"
                },
                "^iperf3_matrix_[0-9]+_(download_mbps|upload_mbps|latency_ms)$": {
                  "type": "number"
                },
                "^network_quality_[0-9]+_(target|address|protocol)$": {
                  "type": "string"
                },
                "^network_quality_[0-9]+_available$": {
                  "type": "boolean"
                },
                "^network_quality_[0-9]+_(success_count|failure_count)$": {
                  "type": "number"
                },
                "^network_quality_[0-9]+_(failure_rate|avg_latency_ms|min_latency_ms|max_latency_ms|jitter_ms)$": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_score",
        "grade",
        "tests_success",
        "tests_failed",
        "tests_skipped",
        "tests_degraded",
        "quality_notes",
        "benchmark_profile",
        "confidence_level",
        "vps_benchmark_summary",
        "share_templates",
        "score_calibration",
        "score_profile",
        "score_breakdown"
      ],
      "properties": {
        "total_score": {
          "type": "number"
        },
        "grade": {
          "type": "string"
        },
        "tests_success": {
          "type": "number"
        },
        "tests_failed": {
          "type": "number"
        },
        "tests_skipped": {
          "type": "number"
        },
        "tests_degraded": {
          "type": "number"
        },
        "performance_note": {
          "type": "string"
        },
        "quality_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benchmark_profile": {
          "type": "object",
          "required": [
            "name",
            "cpu_backend",
            "memory_backend",
            "disk_backend",
            "network_backend",
            "mainstream_count"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "quick",
                "default",
                "full",
                "full_iperf3",
                "full_speedtest",
                "custom"
              ]
            },
            "cpu_backend": {
              "type": "string"
            },
            "memory_backend": {
              "type": "string"
            },
            "disk_backend": {
              "type": "string"
            },
            "network_backend": {
              "type": "string"
            },
            "mainstream_count": {
              "type": "number"
            }
          }
        },
        "confidence_level": {
          "type": "object",
          "required": [
            "level",
            "reasons"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "vps_benchmark_summary": {
          "type": "object",
          "required": [
            "system",
            "cpu",
            "memory",
            "disk",
            "network",
            "scores",
            "confidence"
          ],
          "properties": {
            "benchmark_profile": {
              "type": "string"
            },
            "mainstream_backend_count": {
              "type": "number"
            },
            "system": {
              "type": "object",
              "properties": {
                "cpu_model": {
                  "type": "string"
                },
                "cpu_cores": {
                  "type": "number"
                },
                "cpu_threads": {
                  "type": "number"
                },
                "cpu_frequency_mhz": {
                  "type": "number"
                },
                "memory_total_mb": {
                  "type": "number"
                },
                "memory_available_mb": {
                  "type": "number"
                },
                "disk_total_gb": {
                  "type": "number"
                },
                "disk_available_gb": {
                  "type": "number"
                },
                "disk_type": {
                  "type": "string"
                },
                "os": {
                  "type": "string"
                },
                "os_version": {
                  "type": "string"
                },
                "architecture": {
                  "type": "string"
                },
                "virtualization": {
                  "type": "string"
                },
                "virtualization_vendor": {
                  "type": "string"
                },
                "public_ip": {
                  "type": "string"
                },
                "isp": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "country_code": {
                  "type": "string"
                }
              }
            },
            "cpu": {
              "$ref": "#/$defs/vps_summary_section"
            },
            "memory": {
              "$ref": "#/$defs/vps_summary_section"
            },
            "disk": {
              "$ref": "#/$defs/vps_summary_section"
            },
            "network": {
              "$ref": "#/$defs/vps_summary_section"
            },
            "scores": {
              "$ref": "#/$defs/vps_summary_section"
            },
            "confidence": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "quality_notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "score_profile": {
          "type": "string",
          "enum": [
            "vps",
            "server",
            "workstation"
          ]
        },
        "score_calibration": {
          "type": "object",
          "required": [
            "version",
            "active_profile",
            "active_baselines",
            "grade_thresholds",
            "profiles",
            "notes"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "active_profile": {
              "type": "string",
              "enum": [
                "vps",
                "server",
                "workstation"
              ]
            },
            "active_baselines": {
              "$ref": "#/$defs/score_baselines"
            },
            "grade_thresholds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/grade_threshold"
              }
            },
            "profiles": {
              "type": "object",
              "required": [
                "vps",
                "server",
                "workstation"
              ],
              "properties": {
                "vps": {
                  "$ref": "#/$defs/score_baselines"
                },
                "server": {
                  "$ref": "#/$defs/score_baselines"
                },
                "workstation": {
                  "$ref": "#/$defs/score_baselines"
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "share_templates": {
          "type": "object",
          "required": [
            "plain_text",
            "markdown"
          ],
          "properties": {
            "plain_text": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            }
          }
        },
        "score_breakdown": {
          "type": "object",
          "required": [
            "score_profile",
            "calibration_version",
            "cpu",
            "memory",
            "disk",
            "network",
            "normalized_total"
          ],
          "properties": {
            "score_profile": {
              "type": "string",
              "enum": [
                "vps",
                "server",
                "workstation"
              ]
            },
            "calibration_version": {
              "type": "string"
            },
            "cpu": {
              "$ref": "#/$defs/score_item"
            },
            "memory": {
              "$ref": "#/$defs/score_item"
            },
            "disk": {
              "$ref": "#/$defs/score_item"
            },
            "network": {
              "$ref": "#/$defs/score_item"
            },
            "normalized_total": {
              "type": "object",
              "required": [
                "score",
                "active_weight",
                "weighted_sum",
                "calibration_version",
                "formula"
              ],
              "properties": {
                "score": {
                  "type": "number"
                },
                "active_weight": {
                  "type": "number"
                },
                "weighted_sum": {
                  "type": "number"
                },
                "calibration_version": {
                  "type": "string"
                },
                "formula": {
                  "type": "string"
                },
                "score_profile": {
                  "type": "string",
                  "enum": [
                    "vps",
                    "server",
                    "workstation"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vps_summary_section": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "score_profile": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "upload_estimated": {
          "type": "boolean"
        },
        "ipv4_available": {
          "type": "boolean"
        },
        "ipv6_available": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "single_core_score": {
          "type": "number"
        },
        "multi_core_score": {
          "type": "number"
        },
        "total_score": {
          "type": "number"
        },
        "single_core_events_per_sec": {
          "type": "number"
        },
        "multi_core_events_per_sec": {
          "type": "number"
        },
        "single_core_raw_score": {
          "type": "number"
        },
        "multi_core_raw_score": {
          "type": "number"
        },
        "cpu_cores": {
